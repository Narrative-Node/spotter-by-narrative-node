<?xml version="1.0" encoding="UTF-8"?>
<!-- Spotter by Narrative Node. Opens from Window > Extensions > Spotter in Premiere Pro. -->
<ExtensionManifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   Version="11.0"
                   ExtensionBundleId="com.narrativenode.spotter"
                   ExtensionBundleVersion="1.0.3"
                   ExtensionBundleName="Spotter by Narrative Node">
  <ExtensionList>
    <Extension Id="com.narrativenode.spotter.panel" Version="1.0.3" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- Premiere Pro 2022 (22.0) and later. -->
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.narrativenode.spotter.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine>
            <!-- Node is how the panel lists folders and reads audio for waveforms. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Spotter by Narrative Node</Menu>
          <Geometry>
            <Size>
              <Width>760</Width>
              <Height>520</Height>
            </Size>
            <MinSize>
              <Width>360</Width>
              <Height>300</Height>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/panel-light.png</Icon>
            <Icon Type="RollOver">./icons/panel-light.png</Icon>
            <Icon Type="DarkNormal">./icons/panel-dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/panel-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
